{
  "name": "flight-master-aviation-data-mcp",
  "displayName": "Flight Master Aviation Data MCP",
  "version": "1.0.1",
  "description": "Official aviation data MCP by Flight Master DAST (航班管家 DAST) for flight status, weather, delay risk and trajectories.",
  "author": {
    "name": "Flight Master DAST",
    "url": "https://github.com/flight-master-dast"
  },
  "homepage": "https://dast.133.cn/mcp/",
  "repository": "https://github.com/flight-master-dast/aviation-data-mcp",
  "keywords": [
    "aviation",
    "flight",
    "flight-status",
    "aviation-data",
    "weather",
    "delay-risk",
    "trajectory",
    "flight-master",
    "MCP"
  ],
  "userConfig": {
    "dast_api_key": {
      "type": "string",
      "title": "Flight Master DAST API Key",
      "description": "Enter your Flight Master DAST API Key to access the aviation data MCP service.",
      "sensitive": true,
      "required": true
    }
  },
  "mcpServers": {
    "flight-master-dast": {
      "type": "http",
      "url": "https://fly.huoli.com/mcp/dast_mcp",
      "headers": {
        "Authorization": "Bearer ${user_config.dast_api_key}"
      }
    }
  }
}
